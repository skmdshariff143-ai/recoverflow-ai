# =====================================================================
# RecoverFlow AI — Environment Configuration Example
# =====================================================================

# 1. Razorpay Test-Mode Credentials (Optional for live test-mode links)
# Obtain from: https://dashboard.razorpay.com/app/keys (Test Mode)
# If omitted, RecoverFlow AI automatically uses the offline Deterministic Simulator.
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# 2. Google Gemini AI API Key (Optional for grounded LLM copilot)
# Obtain from: https://aistudio.google.com/
# If omitted, RecoverFlow AI uses deterministic rule-based explainability fallbacks.
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash
