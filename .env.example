# ─── PayBack AI / RecoverFlow AI Environment Variables ────────────────────────
# Razorpay Test Mode API Credentials (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Configured in Webhook settings / Smee proxy)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Google Gemini API Key for Bounded AI Root-Cause Diagnostic Copilot
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
