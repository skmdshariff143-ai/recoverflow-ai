# Safe default: isolated sample data, no provider credentials required.
RECOVERFLOW_RUNTIME_MODE=DEMO
# Exact externally visible origin. Required for durable deployment behind a proxy.
APP_URL=http://localhost:3000

# Required for SANDBOX/LIVE. Generate a random secret with at least 32 characters.
AUTH_SECRET=
DATABASE_URL=postgresql://postgres:recoverflow_local_only@localhost:5432/recoverflow?schema=public
REDIS_URL=redis://localhost:6379

# Run provisioning once with these variables exported, then unset the password.
# OPERATOR_EMAIL=owner@example.com
# OPERATOR_PASSWORD=
# OPERATOR_NAME=Workspace owner
# WORKSPACE_SLUG=my-store
# MERCHANT_NAME=My store
# MERCHANT_URL=https://my-store.example.com

# Optional legacy advisory credentials. The console copilot is deterministic.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Provider dispatch and ingestion are gated in durable modes. See DEPLOYMENT.md.
