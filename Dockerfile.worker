# syntax=docker/dockerfile:1
# RecoverFlow AI — Standalone Recovery Worker Container
# Multi-stage production build with minimal attack surface and non-root execution.

# Stage 1: Dependency & Builder stage
FROM node:20-alpine AS builder

WORKDIR /app

# Install build essentials for native addons if needed
RUN apk add --no-cache libc6-compat

# Copy root and package manifests for workspace resolution
COPY package*.json ./
COPY apps/web/package*.json ./apps/web/
COPY packages/core/package*.json ./packages/core/
COPY packages/agents/package*.json ./packages/agents/
COPY packages/jobs/package*.json ./packages/jobs/
COPY packages/pixel/package*.json ./packages/pixel/

# Install all dependencies (including devDependencies for TypeScript compilation)
RUN npm ci

# Copy full monorepo source tree
COPY . .

# Generate Prisma Client
RUN npx prisma generate --schema=packages/core/prisma/schema.prisma

# Verify TypeScript build
RUN npm run type-check

# Stage 2: Production Runner
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV RECOVERFLOW_RUNTIME_MODE=SANDBOX
ENV PORT=4000

# Install Tini or dumb-init for proper PID 1 signal forwarding (SIGTERM / SIGINT)
RUN apk add --no-cache dumb-init curl

# Create non-root system user and group
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 recoverflow

# Copy installed node_modules and generated Prisma client from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps ./apps
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/tsconfig.json ./

# Set correct file ownership to non-root user
RUN chown -R recoverflow:nodejs /app

USER recoverflow

# Container Healthcheck (Worker HTTP Health Probe)
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:4000/health || exit 1

# dumb-init forwards SIGTERM directly to Node for graceful shutdown
ENTRYPOINT ["dumb-init", "--"]

CMD ["npm", "run", "worker"]
