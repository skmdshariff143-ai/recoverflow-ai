{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@recoverflow/core": ["./packages/core/src/index.ts"],
      "@recoverflow/agents": ["./packages/agents/src/index.ts"],
      "@recoverflow/jobs": ["./packages/jobs/src/index.ts"],
      "@recoverflow/pixel": ["./packages/pixel/src/index.ts"],
      "@recoverflow/shopify-app": ["./packages/shopify-app/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
